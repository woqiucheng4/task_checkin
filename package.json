{
  "name": "growth-orchard-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "admin:build": "npm --prefix admin-web run build",
    "admin:dev": "npm --prefix admin-web run dev --",
    "admin:test": "npm --prefix admin-web run test --",
    "build": "tsc -p tsconfig.build.json",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "tdesign-miniprogram": "1.16.0"
  }
}
