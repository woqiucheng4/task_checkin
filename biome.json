{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!dist", "!coverage", "!node_modules"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
