.page-section { margin-top: 34rpx; }
.page-section__heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; margin-bottom: 12rpx; }
.page-title { color: #20231e; font-size: 36rpx; font-weight: 750; line-height: 1.3; }
.page-subtitle { margin-top: 6rpx; color: #6c7068; font-size: 24rpx; }
.text-link { margin: 0; padding: 8rpx 0; background: transparent; color: #174e2a; font-size: 24rpx; line-height: 1.4; }
.paper-card { padding: 28rpx; border: 2rpx solid #dedbd0; border-radius: 18rpx; background: #fffdf7; }
.soft-card { padding: 28rpx; border-radius: 18rpx; background: #f2f3e4; }
.primary-button { min-height: 88rpx; margin: 28rpx 0 0; border-radius: 14rpx; background: #d93a22; color: #fffdf7; font-size: 29rpx; font-weight: 700; }
.secondary-button { min-height: 88rpx; margin: 20rpx 0 0; border: 2rpx solid #174e2a; border-radius: 14rpx; background: transparent; color: #174e2a; font-size: 27rpx; font-weight: 650; }
.danger-link { margin: 22rpx 0 0; background: transparent; color: #b23725; font-size: 24rpx; }
.field { margin-top: 28rpx; }
.field__label { margin-bottom: 10rpx; color: #30342e; font-size: 25rpx; font-weight: 650; }
.field__input { box-sizing: border-box; width: 100%; min-height: 88rpx; padding: 20rpx 22rpx; border: 2rpx solid #d9d6ca; border-radius: 14rpx; background: #fffdf7; color: #20231e; font-size: 27rpx; }
.field__textarea { min-height: 210rpx; }
.pill { display: inline-flex; align-items: center; padding: 4rpx 12rpx; border-radius: 8rpx; background: #edf0dc; color: #174e2a; font-size: 21rpx; }
.divider { height: 2rpx; margin: 28rpx 0; background: #dedbd0; }
.setting-row { display: flex; align-items: center; justify-content: space-between; gap: 22rpx; min-height: 98rpx; border-bottom: 2rpx solid #dedbd0; }
.setting-row__copy { min-width: 0; }
.setting-row__title { color: #20231e; font-size: 27rpx; font-weight: 650; }
.setting-row__note { color: #767970; font-size: 22rpx; }
.metric-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }
.metric { padding: 24rpx 16rpx; border-radius: 14rpx; background: #f2f3e4; text-align: center; }
.metric__value { color: #174e2a; font-size: 40rpx; font-weight: 750; line-height: 1.2; }
.metric__label { margin-top: 5rpx; color: #6c7068; font-size: 21rpx; }
