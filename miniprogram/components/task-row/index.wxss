.task {
  display: grid;
  grid-template-columns: 96rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 21rpx;
  min-height: 174rpx;
  padding: 0;
  border-bottom: 2rpx solid #dedbd0;
}

.task__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 18rpx;
  background: #edf0dc;
}

.task__icon--family {
  background: #e7eff4;
}

.task__heading {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.task__source {
  flex: none;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #edf0dc;
  color: #174e2a;
  font-size: 20rpx;
}

.task__source--family {
  background: #e7eff4;
  color: #246397;
}

.task__title {
  overflow: hidden;
  color: #20231e;
  font-size: 27rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task__description {
  overflow: hidden;
  margin-top: 10rpx;
  color: #555951;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task__due {
  margin-top: 10rpx;
  color: #d93a22;
  font-size: 18rpx;
}

.task__button,
.task__status {
  margin: 0;
  font-size: 24rpx;
}

.task__button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 164rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 10rpx;
  background: #d93a22;
  color: #fffdf7;
  font-weight: 700;
}

.task__button--revision {
  border: 2rpx solid #d93a22;
  background: transparent;
  color: #d93a22;
}

.task__status {
  display: flex;
  align-items: center;
  justify-content: center;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 32rpx;
  grid-template-rows: auto auto;
  min-width: 214rpx;
  max-width: 260rpx;
  padding: 8rpx 0;
  background: transparent;
  color: #27653a;
  line-height: 1.35;
  text-align: center;
}

.task__status-title {
  grid-column: 1;
  color: #27653a;
  font-size: 21rpx;
  font-weight: 700;
  text-align: right;
}

.task__status-detail {
  grid-column: 1;
  margin-top: 6rpx;
  color: #666961;
  font-size: 17rpx;
  font-weight: 400;
  text-align: right;
}

.task__status-arrow {
  grid-row: 1 / 3;
  grid-column: 2;
  align-self: center;
}
