<view class="nav" role="navigation" aria-label="主要导航">
  <button
    wx:for="{{items}}"
    wx:key="key"
    class="nav__item {{item.selected ? 'nav__item--selected' : ''}}"
    data-path="{{item.path}}"
    bindtap="navigate"
  >
    <image
      wx:if="{{item.activeIcon && item.inactiveIcon}}"
      class="nav__icon"
      src="{{item.selected ? item.activeIcon : item.inactiveIcon}}"
      mode="aspectFit"
      aria-hidden="true"
    />
    <t-icon wx:else name="{{item.icon || item.key}}" size="44rpx" color="{{item.selected ? '#174E2A' : '#74766F'}}" />
    <text>{{item.label}}</text>
  </button>
</view>
