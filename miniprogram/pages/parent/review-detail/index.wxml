<view class="page">
  <view class="child">当前孩子：{{selectedName || '尚未选择'}}</view>
  <view wx:if="{{loading}}">正在加载完成情况</view>
  <view wx:elif="{{selectionRequired || error}}"><view>{{error || selectionMessage}}</view><button bindtap="openSelection">{{selectionRequired ? selectionAction : '返回首页选择孩子'}}</button></view>
  <block wx:elif="{{ready}}">
  <view class="heading"><text class="source">{{source === 'FAMILY' ? '家庭' : '共育分组'}}</text><view class="title">{{title}}</view><view class="child">{{childLabel}} · {{state}}</view></view>
  <view class="section"><view class="section__label">孩子的提交</view><view>{{submissionText}}</view><image wx:for="{{images}}" wx:key="*this" src="{{item}}" mode="widthFix" style="width:100%;margin-top:20rpx;" /></view>
  <view wx:if="{{source !== 'FAMILY'}}" class="section academic"><view class="section__label">教师学习评价</view><view class="status"><t-icon name="check-circle" size="40rpx" color="#174E2A" /><view><view>{{academicLabel}}</view><text>家长只能查看，不能更改教师评价</text></view></view></view>
  <view wx:if="{{canReview}}" class="section reward"><view class="section__label">家庭阳光确认</view><view class="sun"><t-icon name="sunny" size="46rpx" color="#EE9A25" /><view><view>按家庭规则发放阳光</view><text>由服务端计算并记录，重复确认不会重复发放</text></view></view><textarea maxlength="120" placeholder="可填写鼓励或说明（选填）" bindinput="editNote" /></view>
  <button wx:if="{{canReview}}" class="primary" loading="{{working}}" disabled="{{working}}" bindtap="approve">确认完成并发放阳光</button>
  <button wx:if="{{canReview && source === 'FAMILY'}}" class="secondary" disabled="{{working}}" bindtap="revise">请孩子订正</button>
  <button wx:if="{{canReview}}" class="waive" disabled="{{working}}" bindtap="waive">仅保留完成记录，本次不发阳光</button>
  </block>
</view>
