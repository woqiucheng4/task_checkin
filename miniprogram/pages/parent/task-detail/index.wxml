<view class="page">
  <view class="source">{{selectedName || '请选择孩子'}}</view>
  <view class="title">为孩子查看任务</view>
  <view wx:if="{{loading}}" class="note">正在加载任务</view>
  <view wx:elif="{{selectionRequired || error}}" class="section"><view>{{error || selectionMessage}}</view><button bindtap="openSelection">{{selectionRequired ? selectionAction : '返回首页选择任务'}}</button></view>
  <block wx:elif="{{ready}}">
    <view class="source">{{source}}</view>
    <view class="title">{{task.title}}</view>
    <view class="meta"><text>{{task.due}}</text><text>{{task.mode}}</text></view>
    <view class="section"><view class="section__title">任务要求</view><view class="section__copy">{{task.description}}</view><image wx:for="{{images}}" wx:key="*this" class="task-image" src="{{item}}" mode="widthFix" /></view>
    <view wx:if="{{hasSubmission}}" class="section">
      <view class="section__title">孩子的提交记录</view>
      <view wx:if="{{submittedAt}}" class="meta">提交于 {{submittedAt}} · 第 {{submissionRevision}} 次提交</view>
      <view class="section__copy">{{submissionText || (submissionImages.length ? '本次提交包含以下图片' : '已确认完成，无文字或图片说明')}}</view>
      <image wx:for="{{submissionImages}}" wx:key="*this" class="task-image" src="{{item}}" mode="widthFix" />
    </view>
    <view wx:if="{{showAcademic}}" class="section"><view class="section__title">教师学习评价</view><view class="section__copy">{{academicLabel}}</view><view class="section__copy">家长可以查看评价结果；学习审核由老师完成。</view></view>
    <view class="reward"><t-icon name="sunny" size="42rpx" color="#EE9A25" /><text>{{task.reward}}</text></view>
    <view wx:if="{{state === 'REVISION_REQUIRED'}}" class="revision">请和孩子一起订正后再次提交。</view>
    <button wx:if="{{canSubmit}}" class="primary" bindtap="openSubmit">为孩子提交完成情况</button>
    <status-view wx:else kind="{{state === 'SUBMITTED' || state === 'COMPLETED' ? 'success' : 'empty'}}" title="{{statusTitle}}" description="{{statusDescription}}" />
  </block>
</view>
