<app-shell title="家庭设置" subtitle="{{familyName}} · {{roleLabel}}" show-role-switch="{{false}}">
  <view class="family"><view class="family__mark"><t-icon name="home" size="54rpx" color="#174E2A" /></view><view><view class="family__name">{{familyName}}</view><view class="family__note">{{childCount}} 个孩子 · {{memberCount}} 位家庭成员</view></view></view>
  <view class="page-section account-profile">
    <view class="page-title">账号资料</view>
    <view class="page-subtitle">用于本小程序内展示，可随时修改。</view>
    <view class="account-profile__form">
      <button class="account-profile__avatar" open-type="chooseAvatar" bindchooseavatar="chooseAccountAvatar" aria-label="更换账号头像">
        <image wx:if="{{accountAvatarUrl}}" src="{{accountAvatarUrl}}" mode="aspectFill" />
        <t-icon wx:else name="user" size="46rpx" />
      </button>
      <view class="account-profile__fields"><view class="account-profile__label">昵称</view><input class="account-profile__nickname" type="nickname" value="{{accountNickname}}" bindinput="editAccountNickname" maxlength="40" placeholder="请输入昵称" /></view>
    </view>
    <button class="account-profile__save" loading="{{savingAccountProfile}}" disabled="{{savingAccountProfile}}" bindtap="saveAccountProfile">保存账号资料</button>
  </view>
  <view wx:if="{{familyId}}" class="page-section child-setup">
    <view class="page-title">添加孩子</view>
    <view class="page-subtitle">添加到{{familyName}}，可在首页选择孩子查看任务和成长记录。</view>
    <input class="child-setup__input" placeholder="孩子昵称（不必填真实姓名）" value="{{childNickname}}" bindinput="editChildNickname" maxlength="30" disabled="{{addingChild || createdChildId}}" />
    <view wx:if="{{childNotice}}" class="page-subtitle">{{childNotice}}</view>
    <button class="child-setup__submit" bindtap="addChild" loading="{{addingChild}}" disabled="{{loading || addingChild}}">{{createdChildId ? '刷新并查看孩子' : '添加孩子并返回首页'}}</button>
  </view>
  <view class="page-section"><view class="page-title">家庭默认阳光</view><view class="setting-row"><view class="setting-row__copy"><view class="setting-row__title">按真实家庭规则计算</view><view class="setting-row__note">普通 {{rewards.ordinary}} · 重点 {{rewards.focus}} · 挑战 {{rewards.challenge}} · 订正 {{rewards.revision}}</view></view><t-icon name="sunny" size="36rpx" color="#174E2A" /></view></view>
  <view class="page-section"><view class="page-title">家庭和授权</view><button class="setting-row" bindtap="openGroups"><view class="setting-row__copy"><view class="setting-row__title">孩子与学习分组</view><view class="setting-row__note">查看当前孩子已加入的分组和授权范围</view></view><t-icon name="shield" size="36rpx" color="#174E2A" /></button><view wx:for="{{members}}" wx:key="id" class="setting-row"><view class="setting-row__copy"><view class="setting-row__title">{{item.label}}{{item.isSelf ? '（我）' : ''}}</view><view class="setting-row__note">有效家庭成员</view></view></view></view>
  <view class="page-section"><view class="page-title">隐私和账户</view><view class="setting-row"><view class="setting-row__copy"><view class="setting-row__title">提醒偏好（本机）</view><view class="setting-row__note">偏好仅保存在本机；微信订阅消息尚未开通</view></view><switch checked="{{notifications}}" color="#174E2A" bindchange="toggleNotifications" /></view><button class="setting-row" bindtap="openRoles"><view class="setting-row__copy"><view class="setting-row__title">切换身份</view><view class="setting-row__note">当前：{{roleLabel}}</view></view><t-icon name="user-switch" size="36rpx" color="#174E2A" /></button></view>
</app-shell>
<bottom-nav items="{{navigation}}" bindnavigate="navigateTab" />
