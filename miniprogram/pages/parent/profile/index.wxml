<app-shell title="家庭设置" subtitle="小禾家庭 · 家庭管理员" show-role-switch="{{false}}">
  <view class="family"><view class="family__mark"><t-icon name="home" size="54rpx" color="#174E2A" /></view><view><view class="family__name">小禾家庭</view><view class="family__note">2 个孩子 · 2 位家庭成员</view></view></view>
  <view class="page-section"><view class="page-title">任务和阳光</view><view class="setting-row"><view class="setting-row__copy"><view class="setting-row__title">今日重点默认规则</view><view class="setting-row__note">家长没空时自动加入必做和临期任务</view></view><t-icon name="chevron-right" size="34rpx" color="#777A72" /></view><view class="setting-row"><view class="setting-row__copy"><view class="setting-row__title">家庭默认阳光</view><view class="setting-row__note">必做 6 · 重点 8 · 挑战 4</view></view><t-icon name="chevron-right" size="34rpx" color="#777A72" /></view></view>
  <view class="page-section"><view class="page-title">家庭和授权</view><button class="setting-row" bindtap="openGroups"><view class="setting-row__copy"><view class="setting-row__title">学校与辅导班分组</view><view class="setting-row__note">2 个已加入分组</view></view><t-icon name="shield" size="36rpx" color="#174E2A" /></button><view class="setting-row"><view class="setting-row__copy"><view class="setting-row__title">家庭成员</view><view class="setting-row__note">妈妈（管理员）、爸爸（监护人）</view></view><t-icon name="usergroup" size="36rpx" color="#174E2A" /></view></view>
  <view class="page-section"><view class="page-title">通知、隐私和账户</view><view class="setting-row"><view class="setting-row__copy"><view class="setting-row__title">审核与截止提醒</view><view class="setting-row__note">只发送必要通知</view></view><switch checked="{{notifications}}" color="#174E2A" bindchange="toggleNotifications" /></view><button class="setting-row" bindtap="requestExport"><view class="setting-row__copy"><view class="setting-row__title">申请导出家庭数据</view><view class="setting-row__note">提交后可查看审批状态</view></view><t-icon name="download" size="36rpx" color="#174E2A" /></button><button class="setting-row" bindtap="openRoles"><view class="setting-row__copy"><view class="setting-row__title">切换身份</view><view class="setting-row__note">当前：家庭管理员</view></view><t-icon name="user-switch" size="36rpx" color="#174E2A" /></button></view>
</app-shell>
<bottom-nav items="{{navigation}}" bindnavigate="navigateTab" />
