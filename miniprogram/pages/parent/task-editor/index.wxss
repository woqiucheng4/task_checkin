@import "../../../styles/pages.wxss";
.page { min-height: 100vh; padding: 38rpx 36rpx 70rpx; box-sizing: border-box; background: #faf7ee; }
.title { color: #174e2a; font-family: "STKaiti", "KaiTi", serif; font-size: 44rpx; font-weight: 700; }
.note { margin-top: 8rpx; color: #6c7068; font-size: 24rpx; line-height: 1.6; }
.modes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-top: 28rpx; }
.mode { margin: 0; padding: 13rpx 8rpx; border: 2rpx solid #d9d6ca; border-radius: 12rpx; background: #fffdf7; color: #666a62; font-size: 23rpx; }
.mode--selected { border-color: #174e2a; background: #edf0dc; color: #174e2a; font-weight: 700; }
.templates { margin-top: 26rpx; }
.templates button { display: flex; justify-content: space-between; width: 100%; margin: 0; padding: 24rpx 4rpx; border-bottom: 2rpx solid #dedbd0; border-radius: 0; background: transparent; color: #20231e; font-size: 27rpx; text-align: left; }
.templates text { color: #72766e; font-size: 21rpx; }
.ocr { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 360rpx; margin-top: 28rpx; border: 2rpx dashed #9da894; border-radius: 18rpx; background: #f2f3e4; color: #174e2a; font-size: 27rpx; }
.ocr text { margin-top: 10rpx; color: #6c7068; font-size: 22rpx; }
.ocr-result { margin-top: 26rpx; padding: 18rpx; border-left: 6rpx solid #174e2a; background: #edf0dc; color: #174e2a; font-size: 24rpx; }
radio-group { display: flex; gap: 28rpx; color: #4d514a; font-size: 25rpx; }
.reward { padding: 20rpx; border-radius: 12rpx; background: #f7f0d7; color: #6a552e; font-size: 24rpx; }
