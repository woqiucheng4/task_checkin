<view class="page">
  <view class="title">布置家庭任务</view><view class="note">可以手动填写、使用模板，或拍照生成可编辑草稿。</view>
  <view class="modes"><button class="mode {{mode === 'MANUAL' ? 'mode--selected' : ''}}" data-mode="MANUAL" bindtap="chooseMode">手动填写</button><button class="mode {{mode === 'TEMPLATE' ? 'mode--selected' : ''}}" data-mode="TEMPLATE" bindtap="chooseMode">任务模板</button><button class="mode {{mode === 'OCR' ? 'mode--selected' : ''}}" data-mode="OCR" bindtap="chooseMode">拍照识别</button></view>
  <view wx:if="{{mode === 'TEMPLATE'}}" class="templates"><button data-title="整理自己的书桌" bindtap="useTemplate">整理书桌<text>自理 · 15 分钟</text></button><button data-title="阅读课外书 20 分钟" bindtap="useTemplate">课外阅读<text>阅读 · 20 分钟</text></button><button data-title="户外运动 30 分钟" bindtap="useTemplate">户外运动<text>运动 · 30 分钟</text></button></view>
  <view wx:elif="{{mode === 'OCR' && !uploaded}}" class="ocr" bindtap="recognizePhoto"><t-icon name="camera" size="64rpx" color="#174E2A" /><view>拍摄作业单或通知</view><text>识别结果只生成草稿，发布前必须由你确认</text></view>
  <view wx:if="{{mode !== 'TEMPLATE' || uploaded}}" class="form">
    <view wx:if="{{uploaded}}" class="ocr-result">已从照片生成草稿，请逐项确认</view>
    <view class="field"><view class="field__label">任务名称</view><input class="field__input" value="{{title}}" placeholder="例如：整理自己的书桌" bindinput="editTitle" /></view>
    <view class="field"><view class="field__label">截止时间</view><view class="field__input">{{dueAt}}</view></view>
    <view class="field"><view class="field__label">提交方式</view><radio-group><label><radio checked color="#174E2A" />确认完成</label><label><radio color="#174E2A" />拍照上传</label></radio-group></view>
    <view class="field"><view class="field__label">阳光规则</view><view class="reward">按家庭默认规则：必做任务 6 阳光</view></view>
    <button class="primary-button" bindtap="publish">确认并发布</button>
  </view>
</view>
