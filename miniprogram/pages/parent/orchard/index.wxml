<app-shell title="孩子的果园" subtitle="家长和孩子一起记录成长" context-label="{{selectedName || '请选择孩子'}}">
  <view wx:if="{{loading}}" class="page-subtitle">正在加载孩子的果园</view>
  <view wx:elif="{{selectionRequired || error}}" class="page-subtitle"><view>{{error || selectionMessage}}</view><button bindtap="openSelection">{{selectionRequired ? selectionAction : '返回首页选择孩子'}}</button></view>
  <block wx:elif="{{ready}}">
    <orchard-hero title="{{treeName}}" subtitle="孩子的每一次努力都被记录" asset="{{asset}}" current="{{current}}" target="{{target}}" remaining="{{remaining}}" progress-percent="{{progressPercent}}" name="{{treeName}}" />
    <button wx:if="{{mature}}" loading="{{working}}" disabled="{{working}}" bindtap="harvest">为{{selectedName}}采摘果实</button>
    <view wx:if="{{!treeId}}" class="page-section"><view>为{{selectedName}}选择果树</view><button wx:for="{{catalogs}}" wx:key="id" data-catalog-id="{{item.id}}" loading="{{working}}" disabled="{{working}}" bindtap="startNext">种下{{item.name}}</button></view>
    <view class="growth-card"><image src="/assets/orchard/scene-watering.webp" mode="aspectFit" /><view><view>累计成长阳光</view><text>{{lifetimeSunlight}} 阳光</text></view></view>
    <view class="page-section"><view class="page-section__heading"><view><view class="page-title">收获记录</view><view class="page-subtitle">每次采摘的成长纪念</view></view></view><view wx:if="{{!growthCards.length}}" class="page-subtitle">还没有采摘记录，和孩子一起培育第一棵树吧。</view><view wx:for="{{growthCards}}" wx:key="id" class="record"><text>{{item.date}}</text><view><view>{{item.title}}</view><text>已采摘</text></view></view></view>
  </block>
</app-shell>
<bottom-nav items="{{navigation}}" bindnavigate="navigateTab" />
