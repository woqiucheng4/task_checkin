.page { min-height: 100vh; padding: 38rpx 36rpx 70rpx; box-sizing: border-box; background: #faf7ee; }
.title { color: #174e2a; font-family: "STKaiti", "KaiTi", serif; font-size: 44rpx; font-weight: 700; }
.note { margin-top: 8rpx; color: #6c7068; font-size: 24rpx; line-height: 1.6; }
.children { margin: 26rpx 0; white-space: nowrap; }
.child { display: inline-flex; margin: 0 12rpx 0 0; padding: 10rpx 20rpx; border: 2rpx solid #d9d6ca; border-radius: 26rpx; background: #fffdf7; color: #62665f; font-size: 24rpx; line-height: 1.4; }
.child text { margin-left: 8rpx; color: #d93a22; }
.child--selected { border-color: #174e2a; background: #edf0dc; color: #174e2a; font-weight: 700; }
.review { width: 100%; margin: 0; padding: 26rpx 0; border-bottom: 2rpx solid #dedbd0; border-radius: 0; background: transparent; text-align: left; }
.review__top, .review__bottom { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.source { padding: 3rpx 11rpx; border-radius: 6rpx; background: #edf0dc; color: #174e2a; font-size: 21rpx; }
.time { color: #7a7d76; font-size: 21rpx; }
.review__title { margin: 13rpx 0; color: #20231e; font-size: 28rpx; font-weight: 700; }
.review__bottom { color: #29663b; font-size: 22rpx; }
.review__bottom view { display: flex; align-items: center; color: #50554e; }
