<view class="page">
  <view class="title">待审核中心 · {{selectedName || '请选择孩子'}}</view><view class="note">按孩子和等待时间整理；提交后阳光已处于保护状态。</view>
  <scroll-view class="children" scroll-x><button wx:for="{{children}}" wx:key="id" class="child {{item.id === selectedChildId ? 'child--selected' : ''}}" data-id="{{item.id}}" bindtap="selectChild">{{item.nickname}}</button></scroll-view>
  <view wx:if="{{loading}}" class="note">正在加载完成情况</view>
  <view wx:elif="{{selectionRequired || error}}" class="note"><view>{{error || selectionMessage}}</view><button wx:if="{{!children.length || error}}" bindtap="openSelection">{{selectionAction}}</button></view>
  <block wx:else>
  <view wx:if="{{items.length}}" class="list"><button wx:for="{{items}}" wx:key="id" class="review" data-id="{{item.id}}" bindtap="open"><view class="review__top"><text class="source">{{item.source}}</text><text class="time">提交于 {{item.submittedAt}}</text></view><view class="review__title">{{item.title}}</view><view class="review__bottom"><text>{{item.academic}}</text><view>查看提交 <t-icon name="chevron-right" size="30rpx" /></view></view></button></view>
  <status-view wx:else kind="empty" title="暂时没有待审核" description="孩子的新提交会出现在这里" asset="/assets/orchard/scene-empty-tasks.webp" />
  </block>
</view>
