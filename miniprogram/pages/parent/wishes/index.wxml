<view class="page">
  <view class="heading"><view><view class="title">小禾的愿望</view><view class="note">用实际收获的果实记录约定，不做现金兑换。</view></view><button bindtap="beginCreate"><t-icon name="add" size="34rpx" />新建</button></view>
  <view wx:if="{{creating}}" class="create"><view class="label">愿望内容</view><input value="{{title}}" placeholder="和孩子商量一个具体的小愿望" bindinput="editTitle" /><view class="label">目标：3 个果实</view><button bindtap="createWish">保存愿望</button></view>
  <view wx:for="{{wishes}}" wx:key="id" class="wish-card"><view class="wish-card__top"><view class="wish-card__title">{{item.title}}</view><text>{{item.progress}} / {{item.target}}</text></view><progress percent="{{item.progress / item.target * 100}}" stroke-width="7" activeColor="#D93A22" backgroundColor="#E7E3D8" /><view class="wish-card__fruit">已关联：{{item.fruit}}</view><button wx:if="{{item.progress >= item.target}}" bindtap="fulfill">标记已兑现</button></view>
  <view class="harvest"><image src="/assets/orchard/scene-harvest.png" mode="aspectFit" /><view>采摘后的果实会留在图鉴中，也可以由家长关联到愿望。</view></view>
</view>
