@import "../../../styles/pages.wxss";
.children { margin: 4rpx 0 22rpx; white-space: nowrap; }
.child { display: inline-flex; margin: 0 12rpx 0 0; padding: 10rpx 24rpx; border: 2rpx solid #d9d6ca; border-radius: 30rpx; background: #fffdf7; color: #60645d; font-size: 24rpx; line-height: 1.4; }
.child--selected { border-color: #174e2a; background: #edf0dc; color: #174e2a; font-weight: 700; }
.summary { display: grid; grid-template-columns: repeat(3, 1fr) auto; align-items: center; gap: 12rpx; padding: 24rpx; border-radius: 18rpx; background: #f2f3e4; text-align: center; }
.summary__value { color: #174e2a; font-size: 38rpx; font-weight: 750; }
.summary__value--red { color: #d93a22; }
.summary__label { color: #6c7068; font-size: 20rpx; }
.summary button { margin: 0; padding: 13rpx 18rpx; border-radius: 12rpx; background: #d93a22; color: #fffdf7; font-size: 23rpx; }
.tree-brief { display: grid; grid-template-columns: 150rpx 1fr; align-items: center; gap: 18rpx; margin-top: 22rpx; padding: 12rpx 24rpx; border-bottom: 2rpx solid #dedbd0; }
.tree-brief image { width: 150rpx; height: 150rpx; }
.tree-brief__title { color: #174e2a; font-size: 29rpx; font-weight: 700; }
.tree-brief__note { margin-top: 5rpx; color: #6c7068; font-size: 22rpx; line-height: 1.5; }
.guest-intro { padding: 34rpx 30rpx; border-radius: 22rpx; background: #f2f3e4; text-align: center; }
.guest-intro__image { width: 230rpx; height: 230rpx; }
.guest-intro__title { margin-top: 12rpx; color: #174e2a; font-size: 34rpx; font-weight: 700; }
.guest-intro__copy { margin-top: 16rpx; color: #6c7068; font-size: 25rpx; line-height: 1.65; }
.guest-intro__cta { margin-top: 30rpx; border-radius: 16rpx; background: #d93a22; color: #fffdf7; font-size: 29rpx; font-weight: 700; }
