.today-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding-right: 40rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  padding-left: 40rpx;
  background: #faf7ee;
}

.brand__eyebrow {
  color: #174e2a;
  font-size: 25rpx;
  letter-spacing: 2rpx;
}

.brand__title {
  margin-top: 8rpx;
  color: #174e2a;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 70rpx;
  font-weight: 600;
  line-height: 1.15;
}

.brand__subtitle {
  margin-top: 14rpx;
  color: #6c7068;
  font-size: 27rpx;
}

.tree {
  display: block;
  width: 490rpx;
  height: 460rpx;
  margin: -30rpx auto -46rpx;
}

.tree--setup { margin: -32rpx auto -26rpx; }

.journal-date { display: flex; gap: 28rpx; color: #183e24; font-size: 26rpx; letter-spacing: 1rpx; }
orchard-hero { display: block; margin-right: -40rpx; }
.tasks { margin-top: 10rpx; }
.sunlight-note { display: grid; grid-template-columns: 38rpx minmax(0, 1fr) 180rpx; align-items: center; gap: 15rpx; min-height: 102rpx; margin-top: 28rpx; padding: 10rpx 26rpx; border-radius: 14rpx; background: #f6f3e3; color: #4a4c47; font-size: 23rpx; line-height: 1.6; }
.sunlight-note image { width: 180rpx; height: 90rpx; }

.roles {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.setup__back {
  align-self: flex-start;
  min-height: 52rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #174e2a;
  font-size: 24rpx;
  line-height: 1.4;
  white-space: nowrap;
}

.setup__submit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  margin: 0;
  padding: 18rpx 28rpx;
  border: 2rpx solid #d93a22;
  border-radius: 18rpx;
  background: #d93a22;
  color: #fffdf7;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.3;
  white-space: nowrap;
}

.role {
  display: grid;
  grid-template-columns: 54rpx minmax(0, 1fr) 36rpx;
  align-items: center;
  gap: 14rpx;
  width: 100%;
  min-height: 116rpx;
  margin: 0;
  padding: 20rpx 24rpx;
  border: 2rpx solid #d9d6ca;
  border-radius: 18rpx;
  background: #fffdf7;
  color: #174e2a;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.3;
  text-align: left;
}

.role--active {
  border-color: #d93a22;
  background: #d93a22;
  color: #fffdf7;
  transform: translateY(2rpx);
}

.role__hint {
  display: block;
  margin-top: 5rpx;
  color: #6c7068;
  font-size: 22rpx;
  font-weight: 400;
}

.role--active .role__hint {
  color: rgba(255, 253, 247, 0.82);
}

.privacy {
  margin-top: 28rpx;
  color: #7a7d75;
  font-size: 21rpx;
  line-height: 1.6;
  text-align: center;
}

.role-sheet { position: fixed; z-index: 30; inset: 0; }
.role-sheet__mask { position: absolute; inset: 0; background: rgba(22, 35, 26, 0.42); }
.role-sheet__panel { position: absolute; right: 0; bottom: 0; left: 0; box-sizing: border-box; padding: 20rpx 42rpx calc(42rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: #fffdf7; }
.role-sheet__title { color: #174e2a; font-size: 38rpx; font-weight: 700; text-align: center; }
.role-sheet__copy { margin: 16rpx 0 28rpx; color: #5f655d; font-size: 25rpx; line-height: 1.6; text-align: center; }
.role-sheet__panel .role + .role { margin-top: 18rpx; }

.guide-sheet { position: fixed; z-index: 29; inset: 0; }
.guide-sheet__mask { position: absolute; inset: 0; background: rgba(22, 35, 26, 0.42); }
.guide-sheet__panel { position: absolute; right: 0; bottom: 0; left: 0; box-sizing: border-box; padding: 20rpx 42rpx calc(42rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: #fffdf7; }
.guide-sheet__header { display: flex; align-items: center; justify-content: center; position: relative; }
.guide-sheet__title { color: #174e2a; font-size: 38rpx; font-weight: 700; text-align: center; }
.guide-sheet__close { position: absolute; right: -16rpx; top: -14rpx; width: 64rpx; height: 64rpx; margin: 0; padding: 0; border: 0; background: transparent; color: #6c7068; font-size: 42rpx; line-height: 1; }
.guide-sheet__close::after { border: 0; }
.guide-sheet__intro { margin-top: 16rpx; color: #5f655d; font-size: 25rpx; line-height: 1.6; text-align: center; }
.guide-sheet__rules { display: flex; flex-direction: column; gap: 12rpx; margin-top: 24rpx; padding: 20rpx 22rpx; border-radius: 16rpx; background: #f7f5ed; color: #315b3d; font-size: 23rpx; line-height: 1.5; }
.guide-sheet__rules view { display: flex; align-items: center; gap: 12rpx; }
.guide-sheet__rule-number { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 30rpx; height: 30rpx; border-radius: 50%; background: #d93a22; color: #fffdf7; font-size: 20rpx; font-weight: 700; }
.guide-sheet__stage-title { margin-top: 24rpx; color: #174e2a; font-size: 27rpx; font-weight: 700; }
.guide-sheet__stages { max-height: 52vh; margin-top: 12rpx; }
.guide-stage { display: grid; grid-template-columns: 76rpx minmax(0, 1fr); gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid #e8e4d8; }
.guide-stage__progress { align-self: start; padding: 4rpx 0; border-radius: 10rpx; background: #edf2e9; color: #315b3d; font-size: 21rpx; font-weight: 700; text-align: center; }
.guide-stage__name { color: #315b3d; font-size: 25rpx; font-weight: 700; }
.guide-stage__description { margin-top: 4rpx; color: #6c7068; font-size: 22rpx; line-height: 1.5; }

.login-sheet {
  position: fixed;
  z-index: 31;
  inset: 0;
}

.login-sheet__mask {
  position: absolute;
  inset: 0;
  background: rgba(22, 35, 26, 0.42);
}

.login-sheet__panel {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 24rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: #fffdf7;
}

.login-sheet__handle {
  width: 68rpx;
  height: 8rpx;
  margin: 0 auto 28rpx;
  border-radius: 99rpx;
  background: #cfd2c6;
}

.login-sheet__title {
  color: #174e2a;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
}

.login-sheet__copy {
  margin-top: 14rpx;
  color: #5f655d;
  font-size: 25rpx;
  line-height: 1.6;
  text-align: center;
}

.login-sheet__privacy {
  margin-top: 8rpx;
  color: #777c74;
  font-size: 21rpx;
  line-height: 1.6;
  text-align: center;
}

.login-sheet__submit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  margin: 28rpx 0 0;
  padding: 18rpx 28rpx;
  border: 2rpx solid #d93a22;
  border-radius: 16rpx;
  background: #d93a22;
  color: #fffdf7;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.3;
}

.login-sheet__dismiss {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 88rpx;
  margin: 16rpx 0 0;
  padding: 12rpx 28rpx;
  border: 2rpx solid #315b3d;
  border-radius: 16rpx;
  background: #fffdf7;
  color: #315b3d;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.3;
}

.login-sheet__submit::after,
.login-sheet__dismiss::after {
  border: 0;
}

.login-sheet__error {
  margin-top: 18rpx;
  padding: 12rpx 18rpx;
  border-radius: 14rpx;
  background: #fff0eb;
  color: #d93a22;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}
