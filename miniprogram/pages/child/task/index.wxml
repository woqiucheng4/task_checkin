<view class="page">
  <view wx:if="{{state === 'submitted'}}" class="protected">
    <t-icon name="shield" size="46rpx" color="#174E2A" />
    <view><view class="protected__title">已提交，阳光已保护</view><view class="protected__note">等待家长确认；学校任务还会由老师完成学习评价</view></view>
  </view>
  <view wx:elif="{{state === 'revision'}}" class="revision">
    <view class="revision__title">老师请你订正后再次提交</view>
    <view class="revision__copy">朗读第二段时注意句号后的停顿，再试一次。</view>
  </view>
  <view class="source">{{source}}</view>
  <view class="title">{{task.category}} · {{task.title}}</view>
  <view class="meta"><text>{{task.due}}</text><text>{{task.mode}}</text></view>
  <view class="section">
    <view class="section__title">任务要求</view>
    <view class="section__copy">{{task.description}}</view>
  </view>
  <view class="reward"><t-icon name="sunny" size="42rpx" color="#EE9A25" /><text>{{task.reward}}</text></view>
  <button wx:if="{{state === 'pending'}}" class="primary" bindtap="openSubmit">开始完成</button>
  <button wx:elif="{{state === 'revision'}}" class="primary" bindtap="revise">再次提交</button>
  <status-view wx:else kind="success" title="已经安全提交" description="你可以先去完成下一项任务" asset="/assets/orchard/scene-watering.png" />
</view>
