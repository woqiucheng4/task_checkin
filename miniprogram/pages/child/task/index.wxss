.page { min-height: 100vh; padding: 38rpx 36rpx 70rpx; box-sizing: border-box; background: #faf7ee; }
.source { display: inline-flex; padding: 5rpx 14rpx; border-radius: 8rpx; background: #edf0dc; color: #174e2a; font-size: 22rpx; }
.title { margin-top: 22rpx; color: #174e2a; font-family: "STKaiti", "KaiTi", serif; font-size: 46rpx; font-weight: 700; line-height: 1.35; }
.meta { display: flex; gap: 20rpx; margin-top: 16rpx; color: #d93a22; font-size: 24rpx; }
.section { margin-top: 42rpx; padding: 30rpx; border: 2rpx solid #dedbd0; border-radius: 18rpx; background: #fffdf7; }
.section__title { color: #20231e; font-size: 28rpx; font-weight: 700; }
.section__copy { margin-top: 12rpx; color: #4f534c; font-size: 27rpx; line-height: 1.75; }
.reward { display: flex; align-items: center; gap: 12rpx; margin-top: 28rpx; padding: 20rpx 24rpx; border-radius: 14rpx; background: #f7f0d7; color: #4f534c; font-size: 24rpx; }
.primary { margin-top: 38rpx; border-radius: 14rpx; background: #d93a22; color: #fffdf7; font-size: 29rpx; font-weight: 700; }
.protected { display: flex; gap: 16rpx; margin-bottom: 30rpx; padding: 22rpx; border-radius: 14rpx; background: #edf0dc; }
.protected__title { color: #174e2a; font-size: 27rpx; font-weight: 700; }
.protected__note { margin-top: 4rpx; color: #62675e; font-size: 22rpx; line-height: 1.55; }
.revision { margin-bottom: 30rpx; padding: 24rpx; border-left: 7rpx solid #d93a22; background: #f9e9e2; }
.revision__title { color: #9e2d1d; font-size: 27rpx; font-weight: 700; }
.revision__copy { margin-top: 8rpx; color: #5b514d; font-size: 24rpx; line-height: 1.6; }
