<app-shell title="我的果园" subtitle="每一次认真完成，都在这里留下成长" context-label="{{nickname}}" bindroleswitch="openRoles">
  <view wx:if="{{loading}}" class="page-section">正在加载果园…</view>
  <view wx:elif="{{!ready}}" class="page-section">果园暂时无法加载，请检查网络后重试。<button bindtap="onShow">重新加载</button></view>
  <block wx:if="{{ready}}">
  <view class="tree-card">
    <image class="tree-card__image" src="{{asset}}" mode="aspectFit" aria-label="我的果树" />
    <view class="tree-card__copy"><view class="tree-card__title">{{treeName}}</view><view class="tree-card__note">{{current}} / {{target}} 阳光 · {{stage}}</view></view>
    <button wx:if="{{mature}}" class="harvest" bindtap="harvest">采摘果实</button>
  </view>
  <view wx:if="{{selecting}}" class="select-next">
    <view class="page-title">选择下一棵果树</view>
    <view class="choices">
      <button data-fruit="apple" data-name="{{nickname}}的苹果树" bindtap="startNext"><image src="/assets/orchard/apple-seed.webp" mode="aspectFit" /><text>苹果树</text></button>
      <button data-fruit="pear" data-name="{{nickname}}的梨树" bindtap="startNext"><image src="/assets/orchard/pear-mature.webp" mode="aspectFit" /><text>梨树</text></button>
      <button data-fruit="orange" data-name="{{nickname}}的橙子树" bindtap="startNext"><image src="/assets/orchard/orange-mature.webp" mode="aspectFit" /><text>橙子树</text></button>
    </view>
  </view>
  <view class="page-section">
    <view class="page-section__heading"><view><view class="page-title">成长足迹</view><view class="page-subtitle">积累阳光，看小树一点点长大</view></view></view>
    <scroll-view class="stage-scroll" scroll-x enable-flex>
      <view wx:for="{{stages}}" wx:key="label" class="stage {{item.done ? 'stage--done' : ''}}"><image src="{{item.asset}}" mode="aspectFit" /><text>{{item.label}}</text></view>
    </scroll-view>
  </view>
  <view class="page-section">
    <view class="page-section__heading"><view><view class="page-title">水果图鉴</view><view class="page-subtitle">成熟并采摘后点亮</view></view></view>
    <view class="collection"><view wx:for="{{collection}}" wx:key="name" class="fruit {{item.count === 0 ? 'fruit--locked' : ''}}"><image src="{{item.asset}}" mode="aspectFit" /><view>{{item.name}}</view><text>{{item.count > 0 ? '已收获 ' + item.count : '待解锁'}}</text></view></view>
  </view>
  </block>
</app-shell>
<bottom-nav items="{{navigation}}" bindnavigate="navigateTab" />
