@import "../../../styles/pages.wxss";
.profile-card { display: grid; grid-template-columns: 118rpx 1fr; align-items: center; gap: 22rpx; padding: 24rpx; border-radius: 18rpx; background: #f2f3e4; }
.profile-card image { width: 118rpx; height: 118rpx; }
.profile-card__name { color: #174e2a; font-size: 33rpx; font-weight: 700; }
.profile-card__note { margin-top: 5rpx; color: #666b62; font-size: 23rpx; }
.setting-row { width: 100%; margin: 0; padding: 0; border: 0; border-bottom: 2rpx solid #dedbd0; border-radius: 0; background: transparent; text-align: left; }
