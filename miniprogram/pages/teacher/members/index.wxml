<view class="page">
 <view class="heading"><view><view class="title">成员与入组审批</view><view class="note">{{groupName}} · 仅展示已同意披露的内容</view></view><button disabled="{{working}}" loading="{{working}}" bindtap="createInvite">生成邀请码</button></view>
 <view wx:if="{{inviteOpen}}" class="invite"><view><view>长按复制邀请码，发送给家长</view><text selectable style="word-break:break-all;">{{inviteCode}}</text><view>有效期至 {{inviteExpires}} · 入组仍需审核</view></view></view>
 <view class="section"><view class="section__title">待审批入组 {{pending.length}}</view><view wx:if="{{!pending.length}}" class="note">暂无待审批申请</view><view wx:for="{{pending}}" wx:key="id" class="request"><view><view>{{item.name}}</view><text>监护人已提交披露授权申请</text></view><button data-id="{{item.id}}" disabled="{{working}}" bindtap="approve">批准</button><button data-id="{{item.id}}" disabled="{{working}}" bindtap="reject">拒绝</button></view></view>
 <view class="section"><view class="section__title">有效成员 {{members.length}}</view><view wx:for="{{members}}" wx:key="organizationMemberId" class="staff"><view><view>{{item.displayName}}</view><text>{{item.grade ? item.grade + '年级' : '未披露年级'}}</text></view></view></view>
</view>
