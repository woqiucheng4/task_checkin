<view class="page">
 <view class="source">分组学习审核</view><view class="title">{{title}}</view><view class="meta">{{childLabel}} · {{submittedAt}}</view>
 <view class="evidence"><view><view>最新提交内容</view><text>{{submissionText}}</text></view></view>
 <image wx:for="{{images}}" wx:key="*this" src="{{item}}" mode="widthFix" style="width:100%;margin-top:20rpx;" />
 <view wx:if="{{canReview}}" class="field"><view>本次学习评价</view><textarea maxlength="200" placeholder="写下肯定或具体订正建议" bindinput="editNote" /></view>
 <view class="separation"><t-icon name="info-circle" size="36rpx" color="#246397" /><text>教师不会直接发放家庭奖励，阳光由家长确认。</text></view>
 <button wx:if="{{canReview}}" class="approve" loading="{{working}}" disabled="{{working}}" bindtap="approve">学习评价通过</button><button wx:if="{{canReview}}" class="revise" disabled="{{working}}" bindtap="revise">需要继续订正</button>
 <view wx:else class="meta">当前记录无需再次审核，或正在等待孩子提交。</view>
</view>
