.page { min-height: 100vh; padding: 38rpx 36rpx 70rpx; box-sizing: border-box; background: #faf7ee; }
.source { color: #174e2a; font-size: 22rpx; }
.title { margin-top: 10rpx; color: #174e2a; font-family: "STKaiti", "KaiTi", serif; font-size: 39rpx; font-weight: 700; }
.meta { margin-top: 7rpx; color: #6c7068; font-size: 22rpx; }
.evidence { display: grid; grid-template-columns: 94rpx 1fr; align-items: center; gap: 20rpx; margin-top: 28rpx; padding: 30rpx; border: 2rpx solid #dedbd0; border-radius: 17rpx; background: #fffdf7; color: #20231e; font-size: 27rpx; }
.evidence text { color: #6c7068; font-size: 21rpx; }
.history { margin-top: 22rpx; padding: 22rpx; border-left: 6rpx solid #d93a22; background: #f9e9e2; color: #60524e; font-size: 23rpx; }
.history__title { margin-bottom: 6rpx; color: #9e2d1d; font-weight: 700; }
.field { margin-top: 28rpx; color: #30342e; font-size: 25rpx; font-weight: 700; }
textarea { box-sizing: border-box; width: 100%; min-height: 170rpx; margin-top: 10rpx; padding: 18rpx; border: 2rpx solid #d9d6ca; border-radius: 14rpx; background: #fffdf7; font-size: 24rpx; font-weight: 400; }
.separation { display: grid; grid-template-columns: 42rpx 1fr; gap: 10rpx; margin-top: 22rpx; padding: 18rpx; border-radius: 12rpx; background: #e7eff4; color: #405c70; font-size: 21rpx; line-height: 1.55; }
.approve, .revise { margin-top: 24rpx; border-radius: 13rpx; font-size: 26rpx; font-weight: 700; }
.approve { background: #d93a22; color: #fffdf7; }
.revise { border: 2rpx solid #174e2a; background: transparent; color: #174e2a; }
