<view class="page">
  <view class="title">发布到三年级 2 班</view><view class="note">任务会同步出现在孩子和家长端；家长可查看学习评价并确认阳光。</view>
  <view class="modes"><button class="mode {{mode === 'MANUAL' ? 'mode--selected' : ''}}" data-mode="MANUAL" bindtap="chooseMode">手动填写</button><button class="mode {{mode === 'TEMPLATE' ? 'mode--selected' : ''}}" data-mode="TEMPLATE" bindtap="chooseMode">复用模板</button><button class="mode {{mode === 'OCR' ? 'mode--selected' : ''}}" data-mode="OCR" bindtap="chooseMode">拍照识别</button></view>
  <button wx:if="{{mode === 'OCR' && !uploaded}}" class="ocr" bindtap="recognizePhoto"><t-icon name="camera" size="60rpx" color="#174E2A" /><view>拍摄作业单生成草稿</view><text>发布前由教师逐项确认</text></button>
  <view wx:else class="form"><view class="field"><view class="label">任务名称</view><input value="{{title}}" placeholder="例如：朗读《秋天的雨》" bindinput="editTitle" /></view><view class="field"><view class="label">学科</view><view class="select">语文</view></view><view class="grid"><view class="field"><view class="label">开始</view><view class="select">今天 16:00</view></view><view class="field"><view class="label">截止</view><view class="select">今天 20:00</view></view></view><view class="field"><view class="label">提交方式</view><view class="select">确认完成</view></view><view class="review"><switch checked color="#174E2A" /><view><view>需要教师学习审核</view><text>审核结果与家庭阳光确认分别记录</text></view></view><button class="primary" bindtap="publish">确认发布</button></view>
</view>
