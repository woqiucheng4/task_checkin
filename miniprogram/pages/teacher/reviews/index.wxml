<view class="page">
 <view class="title">学生提交</view><view class="note">{{groupName}} · 查看真实学习状态</view>
 <view class="filters"><button class="{{filter === 'PENDING' ? 'selected' : ''}}" data-filter="PENDING" bindtap="chooseFilter">待审核</button><button class="{{filter === 'REVISION' ? 'selected' : ''}}" data-filter="REVISION" bindtap="chooseFilter">需订正</button><button class="{{filter === 'DONE' ? 'selected' : ''}}" data-filter="DONE" bindtap="chooseFilter">已完成</button></view>
 <view wx:if="{{error || !items.length}}" class="note">{{error || '当前状态下暂无记录'}}</view>
 <button wx:for="{{items}}" wx:key="id" class="student" data-id="{{item.id}}" bindtap="open"><view class="avatar">{{index + 1}}</view><view><view class="student__name">{{item.name}} · {{item.title}}</view><text>{{item.status}} · {{item.time}}</text></view><t-icon name="chevron-right" size="34rpx" color="#6C7068" /></button>
</view>
