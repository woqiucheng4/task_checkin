<app-shell title="教师设置" subtitle="{{roleLabel}}" show-role-switch="{{false}}">
 <view class="identity"><view class="identity__mark"><t-icon name="education" size="54rpx" color="#174E2A" /></view><view><view>{{roleLabel}}</view><text>{{organizationName}} · {{groupName}}</text></view></view>
 <view class="page-section account-profile"><view class="page-title">账号资料</view><view class="page-subtitle">用于本小程序内展示，可随时修改。</view><view class="account-profile__form"><button class="account-profile__avatar" open-type="chooseAvatar" bindchooseavatar="chooseAccountAvatar" aria-label="更换账号头像"><image wx:if="{{accountAvatarUrl}}" src="{{accountAvatarUrl}}" mode="aspectFill" /><t-icon wx:else name="user" size="46rpx" /></button><view class="account-profile__fields"><view class="account-profile__label">昵称</view><input class="account-profile__nickname" type="nickname" value="{{accountNickname}}" bindinput="editAccountNickname" maxlength="40" placeholder="请输入昵称" /></view></view><button class="account-profile__save" loading="{{savingAccountProfile}}" disabled="{{savingAccountProfile}}" bindtap="saveAccountProfile">保存账号资料</button></view>
 <view class="page-section"><view class="page-title">工作设置</view><view class="setting-row"><view class="setting-row__copy"><view class="setting-row__title">提醒偏好（本机）</view><view class="setting-row__note">仅记录偏好，微信订阅消息尚未开通</view></view><switch checked="{{notify}}" color="#174E2A" bindchange="toggleNotify" /></view></view>
 <view class="page-section"><view class="page-title">权限和账户</view><view class="setting-row"><view class="setting-row__copy"><view class="setting-row__title">当前分组权限</view><view class="setting-row__note">{{roleLabel}} · 所有操作由服务端重新验证</view></view><t-icon name="shield" size="36rpx" color="#174E2A" /></view><button class="setting-row" bindtap="openRoles"><view class="setting-row__copy"><view class="setting-row__title">切换身份</view><view class="setting-row__note">家庭和机构数据按授权范围访问</view></view><t-icon name="user-switch" size="36rpx" color="#174E2A" /></button><view class="setting-row"><view class="setting-row__copy"><view class="setting-row__title">隐私与审计</view><view class="setting-row__note">只查看当前分组已授权内容，不读取家庭愿望和家庭任务</view></view></view></view>
</app-shell><bottom-nav items="{{navigation}}" bindnavigate="navigateTab" />
