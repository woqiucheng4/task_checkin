<view class="page">
 <view class="title">{{groupName}}共育树</view><view class="note">{{memberCount}} 名有效成员共同成长</view><image class="tree" src="/assets/orchard/scene-group-tree.png" mode="aspectFit" aria-label="班级共同培育的果树" />
 <view wx:if="{{treeId}}" class="progress"><view class="progress__top"><view><view>{{progress}} / {{target}} 共同成长</view><text>{{mature ? '果树已成熟，可以记录共同收获' : '学习审核通过后，共育树会同步成长'}}</text></view><t-icon name="sunny" size="48rpx" color="#EE9A25" /></view><progress percent="{{progressPercent}}" stroke-width="8" activeColor="#D93A22" backgroundColor="#E7E3D8" /></view>
 <button wx:if="{{!treeId}}" disabled="{{working}}" loading="{{working}}" bindtap="startTree">种下班级共育树</button><button wx:if="{{mature}}" disabled="{{working}}" loading="{{working}}" bindtap="harvest">记录共同收获</button>
 <view class="principle"><t-icon name="shield" size="40rpx" color="#174E2A" /><view><view>共同成长，不做个人排名</view><text>只显示班级总体进度，不展示个人贡献榜。</text></view></view>
</view>
