@import "../../../styles/pages.wxss";
.activation-form { display: grid; gap: 14rpx; margin-top: 30rpx; }
.activation-form text { color: #174e2a; font-size: 26rpx; font-weight: 700; }
.activation-form input { padding: 20rpx; border: 2rpx solid #d9d6ca; border-radius: 12rpx; background: #fffdf7; font-size: 28rpx; }
.activation-form button { margin-top: 18rpx; border-radius: 12rpx; background: #174e2a; color: #fffdf7; }
.activation-error { color: #aa3b28; }
